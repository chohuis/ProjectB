    "measure:devplayer": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-devplayer.cjs",
    "study:careers": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/study-careers.cjs",
