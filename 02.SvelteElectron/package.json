    "check:josa": "node scripts/check-josa.cjs",
    "check:tone": "node scripts/check-tone.cjs",
    "check:tiers": "node scripts/check-tiers.cjs",
    "check:eventslots-health": "node scripts/check-eventslots-health.cjs",
