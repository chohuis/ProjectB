    "probe:hscloser": "cross-env DRIVE_USER_DATA=1 ELECTRON_RUN_AS_NODE=1 electron scripts/probe-hs-closer.cjs",
    "probe:morale": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-morale.cjs",
    "probe:paths": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-paths.cjs",
    "probe:d:e2": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-d-e2-runall.cjs",
    "probe:d:dr": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-d-dr-draft.cjs",
    "check:measurerepro": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-measure-repro.cjs",
