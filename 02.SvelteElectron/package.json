    "probe:traits": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-traits.cjs",
    "probe:ovrimpact": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-ovrimpact.cjs",
    "probe:sangmu": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/probe-sangmu.cjs",
