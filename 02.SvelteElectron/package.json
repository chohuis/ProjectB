    "lint": "eslint \"apps/**/*.{ts,svelte,cjs}\" \"packages/*/src/**/*.ts\"",
    "lint:fix": "eslint \"apps/**/*.{ts,svelte,cjs}\" \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage --coverage.include=apps/ui/src/** --coverage.exclude=**/__tests__/**"
  },
  "build": {
    "appId": "com.projectb.desktop",
    "productName": "OnePitch",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/**",
      "dev-server.config.cjs",
      "dist/ui/**",
      "packages/*/dist/**",
      "packages/*/package.json",
      "packages/engine-native/index.js",
      "packages/engine-native/*.node",
      "resource/**",
      "!resource/data/staging/**",
      "!resource/data/balance/**",
      "!resource/data/master/entities/players/**",
      "!scripts/**",
      "!docs/**",
      "!resource/logs/**",
      "!resource/data/seeds/**",
      "!dist/ui/logs/**",
      "!dist/ui/data/staging/**",
      "!dist/ui/data/balance/**",
      "!dist/ui/data/seeds/**",
      "!dist/ui/data/master/entities/players/**"
    ],
    "asarUnpack": [
      "resource/**",
      "packages/*/dist/**",
      "packages/*/package.json",
      "packages/engine-native/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir"
        }
      ]
    },
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "svelte": "^5.38.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "omggif": "^1.0.10",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "simple-git-hooks": "^2.14.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.2",
    "vitest": "^3.2.6"
  },
  "simple-git-hooks": {
    "pre-commit": "cd 02.SvelteElectron && npx lint-staged"
  },
  "lint-staged": {
    "apps/**/*.{ts,svelte,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/*/src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
