{
  "name": "projectb-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "OnePitch — 투수 인생 시뮬레이션 (Svelte + Electron)",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "build:contracts": "npm run -w @projectb/contracts build",
    "build:core": "npm run -w @projectb/core build",
    "build:native": "npm run -w @projectb/engine-native build",
    "build:packages": "npm run build:contracts && npm run build:core",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "gen:contacts": "node scripts/gen-manifest.mjs --force",
    "dev:ui": "npm run gen:manifest && vite --config vite.config.ts",
    "dev:desktop": "npm run build:masterdb && npm run build:packages && node scripts/wait-for-port.cjs && node scripts/dev-electron.cjs",
    "predev": "npm run build:native || echo [engine-native] Rust 빌드 실패 - match engine stubs 사용 (dev 전용)",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:desktop\"",
    "build:ui": "npm run gen:manifest && vite build --config vite.config.ts",
    "build:masterdb": "electron scripts/generate_master_db.cjs",
    "prebuild": "npm run build:native",
    "build": "npm run build:masterdb && npm run build:packages && npm run build:ui",
    "predeploy": "npm run build",
    "preview:ui": "vite preview --config vite.config.ts",
    "start": "electron apps/desktop/main.cjs",
    "pack": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "check:i18n:keys": "node scripts/check-i18n-keys.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:encoding": "npm run check:mojibake",
    "deploy": "node scripts/deploy-staging.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:db": "electron scripts/db-perf.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit": "npm audit --audit-level=high",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:slotdb": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-slotdb.cjs",
    "test:rostergen": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-roster-gen.cjs",
    "test:draft": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-draft.cjs",
    "test:promotion": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-promotion.cjs",
    "test:military": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-military.cjs",
    "test:fa": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-fa.cjs",
    "test:staff": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-staff.cjs",
    "test:injury": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-injury.cjs",
    "test:finance": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-finance.cjs",
    "test:sentencebank": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-sentencebank.cjs",
    "test:campus": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-campus.cjs",
    "smoke:draft": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-draft-db.cjs",
    "measure:draft": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-draft.cjs",
    "measure:finance": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-finance.cjs",
    "measure:promotion": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-promotion.cjs",
    "measure:slotsize": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-slotsize.cjs",
    "test:newgame": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-newgame-v3.cjs",
    "test:regional": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-regional-schedule.cjs",
    "test:tournament": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-tournament.cjs",
    "test:groupstage": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-group-stage.cjs",
    "test:survival": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-survival.cjs",
    "test:propo": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-pro-postseason.cjs",
    "test:pitchrules": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-pitch-rules.cjs",
    "test:stafflife": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-staff-lifecycle.cjs",
    "test:career": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-career-transition.cjs",
    "test:teamhistory": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-team-history.cjs",
    "test:v3": "npm run test:migration && npm run test:slotdb && npm run test:rostergen && npm run test:newgame && npm run test:draftpool && npm run test:regional && npm run test:tournament && npm run test:groupstage && npm run test:survival && npm run test:propo && npm run test:pitchrules && npm run test:staffgen && npm run test:stafflife && npm run test:career && npm run test:teamhistory && npm run test:relationship && npm run test:releasescope && npm run test:draft && npm run test:promotion && npm run test:military && npm run test:fa && npm run test:staff && npm run test:injury && npm run test:finance && npm run test:sentencebank && npm run test:campus && npm run test:savebatch && npm run test:growth",
    "test:draftpool": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-draft-pool.cjs",
    "test:synthetic": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-synthetic-trajectory.cjs",
    "test:migration": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-migration.cjs",
    "harness": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/harness.cjs",
    "test:staffgen": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-staff-gen.cjs",
    "test:relationship": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-relationship.cjs",
    "test:releasescope": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-release-scope.cjs",
    "measure:perf": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-perf.cjs",
    "test:savebatch": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-savebatch.cjs",
    "scenarios": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/run-scenarios.cjs",
    "test:careerpaths": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-careerpaths.cjs",
    "test:foreign": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-foreign.cjs",
    "measure:batting": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-batting.cjs",
    "test:rosterbalance": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-roster-balance.cjs",
    "audit:engine": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/audit-engine.cjs",
    "test:events": "node scripts/test-events.cjs",
    "test:growth": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-growth.cjs",
    "check:thresholds": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-thresholds.cjs",
    "check:teamrefs": "node scripts/check-teamrefs.cjs",
    "check:offseason": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-offseason.cjs",
    "check:injurynews": "node scripts/check-injurynews.cjs",
    "diag:postseason": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/diag-postseason.cjs",
    "diag:univtour": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/diag-univtour.cjs",
    "diag:roster": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/diag-roster.cjs",
    "check:foreignorigin": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-foreign-origin.cjs",
    "check:foreignseed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-foreign-seed.cjs",
    "check:namepair": "node scripts/check-namepair.cjs",
    "check:namelocale": "node scripts/check-namelocale.cjs",
    "check:teamcolors": "node scripts/check-teamcolors.cjs",
    "test:neededpositions": "node scripts/test-neededpositions.cjs",
    "test:npclifecycle": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-npclifecycle.cjs",
    "measure:traits": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-traits.cjs",
    "check:traits": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-traits.cjs",
    "fit:park": "node scripts/fit-park-anchors.cjs",
    "check:park": "node scripts/check-park.cjs",
    "check:devplayer": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-devplayer.cjs",
    "measure:devplayer": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-devplayer.cjs",
    "study:careers": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/study-careers.cjs",
    "check:arsenal": "node scripts/check-arsenal.cjs",
    "check:trainingtable": "node scripts/check-training-table.cjs",
    "measure:training": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-training.cjs",
    "measure:relations": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-relations.cjs",
    "measure:mailbox": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-mailbox.cjs",
    "measure:messagekinds": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/measure-message-kinds.cjs",
    "check:seasonendguard": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-seasonend-guard.cjs",
    "check:protransition": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/check-pro-transition.cjs"
  },
  "build": {
    "appId": "com.projectb.desktop",
    "productName": "OnePitch",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/**",
      "dist/ui/**",
      "packages/*/dist/**",
      "packages/*/package.json",
      "packages/engine-native/index.js",
      "packages/engine-native/*.node",
      "resource/**",
      "!resource/data/staging/**",
      "!resource/data/balance/**",
      "!resource/data/master/entities/players/**",
      "!scripts/**",
      "!docs/**"
    ],
    "asarUnpack": [
      "resource/**",
      "packages/*/dist/**",
      "packages/*/package.json",
      "packages/engine-native/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir"
        }
      ]
    },
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "svelte": "^5.38.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^22.15.21",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "omggif": "^1.0.10",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.2",
    "vitest": "^3.2.6"
  }
}
